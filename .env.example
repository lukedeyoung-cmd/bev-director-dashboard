# Copy to .env for local development (Flask's CLI auto-loads it via python-dotenv).
# In production, set these as real environment variables. Never commit .env.

# Required. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Postgres connection string (psycopg driver form).
DATABASE_URL=postgresql+psycopg://bev:bev@localhost:5432/bev

# Unset or true in production (cookies over TLS only). Local HTTP dev: false.
SESSION_COOKIE_SECURE=false
