# Copy to .env for local development (Flask's CLI auto-loads it via python-dotenv).
# In production, set these as real environment variables. Never commit .env.

# Required. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Postgres connection string (psycopg driver form).
DATABASE_URL=postgresql+psycopg://bev:bev@localhost:5432/bev

# Unset or true in production (cookies over TLS only). Local HTTP dev: false.
SESSION_COOKIE_SECURE=false

# --- Toast POS integration -------------------------------------------------
# Org-level Toast machine client (Toast portal: Integrations & Extensions -> API
# Access). Each venue's restaurant GUID lives on its Venue row (pos_venue_ref).
# Dev-only credentials (e.g. Olivers) belong only in your local .env, never in
# the repo; L&SD production credentials replace them by config change alone.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# Override only for testing against the sandbox host (default is production).
# TOAST_API_HOST=https://ws-api.toasttab.com
# Default historical depth (days) for `flask toast-backfill` when --start is omitted.
# TOAST_BACKFILL_DAYS=365

# --- Morning digest email ----------------------------------------------------
# Daily 07:00 America/Chicago via scripts/morning_digest.sh (cron) or the manual
# trigger POST /api/digest/send. SendGrid API key (Secrets: SECRET_SENDGRID_API_KEY).
# The From address MUST be a verified sender in that SendGrid account.
SENDGRID_API_KEY=
# Must be a verified sender in the SendGrid account (verified: luke@eatatolivers.com).
DIGEST_FROM_EMAIL=luke@eatatolivers.com
DIGEST_RECIPIENTS=luke.deyoung@gmail.com
# Dashboard link rendered in the email footer (placeholder until hosting lands).
DASHBOARD_URL=https://bev-director-dashboard.example
# Alert sensitivity: sales swing % vs prior day (above a $ floor), pour-variance
# % vs recipe theoretical, price-change % vs prior catalog version.
# DIGEST_SWING_PCT=40
# DIGEST_SWING_FLOOR=200
# DIGEST_VARIANCE_PCT=10
# DIGEST_PRICE_PCT=10

