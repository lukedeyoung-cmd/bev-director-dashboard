# Copy to .env for local development (Flask's CLI auto-loads it via python-dotenv).
# In production, set these as real environment variables. Never commit .env.

# Required. Generate with: openssl rand -hex 32
SECRET_KEY=change-me

# Postgres connection string (psycopg driver form).
DATABASE_URL=postgresql+psycopg://bev:bev@localhost:5432/bev

# Unset or true in production (cookies over TLS only). Local HTTP dev: false.
SESSION_COOKIE_SECURE=false

# --- Toast POS integration -------------------------------------------------
# Org-level Toast machine client (Toast portal: Integrations & Extensions -> API
# Access). Each venue's restaurant GUID lives on its Venue row (pos_venue_ref).
# Dev-only credentials (e.g. Olivers) belong only in your local .env, never in
# the repo; L&SD production credentials replace them by config change alone.
TOAST_CLIENT_ID=
TOAST_CLIENT_SECRET=
# Override only for testing against the sandbox host (default is production).
# TOAST_API_HOST=https://ws-api.toasttab.com
# Default historical depth (days) for `flask toast-backfill` when --start is omitted.
# TOAST_BACKFILL_DAYS=365

